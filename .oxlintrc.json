{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-control-regex": "error",
    // Advisory: both remaining hook-deps findings are deliberate — src/app.tsx:347
    // re-picks on every pasted link, and src/components/fullscreen.tsx:16 closes
    // over a `dimensions()` helper that only reads `stdout` (already a dep).
    // Adding them would change effect timing, so they warn instead of failing CI.
    "react/exhaustive-deps": "warn",
    // Pre-existing: the TUI drives its phase machine from effects and async
    // callbacks (src/app.tsx:230, src/app.tsx:346). Deriving that during render
    // is the src/core/engine.ts refactor, not a lint fix.
    "react/set-state-in-effect": "warn",
    // False positive here: it flags reading a hoisted `function` declaration
    // before its source position (web/src/SettingsDialog.tsx:47 `run`), which is
    // fine at runtime, and a callback read in src/app.tsx:225 that is only ever
    // invoked after mount.
    "react/immutability": "off",
    // Spread copies are deliberate where the loop body mutates the collection
    // being iterated (src/server/limits.ts prune, src/server/server.ts shutdown).
    "unicorn/no-useless-spread": "off",
    // Latest-ref writes (src/lib/use-mouse-click.ts:16) plus one render-phase
    // mirror read (src/components/text-input.tsx:173) — pre-existing and benign
    // in Ink's single-pass renderer.
    "react/refs": "off"
  },
  "overrides": [
    {
      "files": ["src/lib/use-mouse-click.ts", "src/lib/ytdlp.ts", "src/components/panel.test.ts"],
      // These parse terminal escape sequences and sanitize filenames, so matching control characters is the point.
      "rules": {"no-control-regex": "off"}
    },
    {
      "files": ["src/**/*.test.ts"],
      // Tests build elements with React.createElement, which takes children inside the props object.
      "rules": {"react/no-children-prop": "off"}
    }
  ],
  "ignorePatterns": ["dist", "release", "build", "node_modules", "expo", "assets", ".atl"]
}
